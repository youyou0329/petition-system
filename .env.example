# Supabase 数据库配置（必需）
# 在 https://supabase.com 创建项目后获取
COZE_SUPABASE_URL=https://your-project.supabase.co
COZE_SUPABASE_ANON_KEY=your_supabase_anon_key
COZE_SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# AI 模型配置（二选一，必需）
# 方式1: 使用 DeepSeek API（推荐，价格便宜）
DEEPSEEK_API_KEY=your_deepseek_api_key

# 方式2: 使用 Coze API（豆包模型）
COZE_API_TOKEN=your_coze_api_token
COZE_BOT_ID=your_bot_id

# 对象存储配置（可选 - 用于文书上传检查）
COZE_BUCKET_ENDPOINT_URL=your_bucket_endpoint
COZE_BUCKET_NAME=your_bucket_name
